.si-fb{background:#1877f2}.si-tt{background:#000000;box-shadow:0 3px 10px rgba(0,0,0,.35)}.si-ig{background:linear-gradient(135deg,#f09433,#dc2743,#bc1888)}.si-wa{background:#25d366}.si-wg{background:#128c7e}.si-gm{background:#ea4335}
.sl-txt strong{font-size:13px;font-weight:700;display:block}
.sl-txt small{font-size:10px;color:var(--muted)}
.sl-btn:hover .sl-txt small{color:rgba(255,255,255,.7)}
.btn-wa-big{display:flex;align-items:center;justify-content:center;gap:10px;background:#22c55e;color:#fff;padding:15px;border-radius:50px;font-size:15px;font-weight:700;box-shadow:0 4px 20px rgba(34,197,94,.25);transition:all .2s}
.btn-wa-big:hover{background:#16a34a;transform:translateY(-2px)}

/* FOOTER */
.footer{background:#080B16;border-top:1px solid rgba(255,255,255,.08);position:relative}
.ft-in{max-width:1200px;margin:0 auto;padding:56px 32px 40px;display:grid;grid-template-columns:2fr 1fr 1fr;gap:40px;border-bottom:1px solid rgba(255,255,255,.08)}
.ft-logo{display:flex;align-items:center;gap:10px;margin-bottom:14px}
