/* HERO FLOATING 3D GLASS BUBBLES */
.hero-bubble{
  position:absolute;
  border-radius:50%;
  pointer-events:none;
  background:radial-gradient(circle at 30% 28%, rgba(255,255,255,0.92) 0%, rgba(255,255,255,0.45) 20%, rgba(59,91,255,0.14) 55%, rgba(139,62,242,0.2) 80%, rgba(34,211,238,0.26) 100%);
