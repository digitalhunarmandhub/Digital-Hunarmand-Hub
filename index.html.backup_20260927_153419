.int-left h2{font-size:clamp(28px,3.5vw,44px);font-weight:800;letter-spacing:-1px;margin-bottom:16px}
.int-left p{font-size:15px;color:var(--muted);line-height:1.8;margin-bottom:28px}
.int-meta{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:28px}
.int-meta-item{background:var(--bg-cream-card);border:1px solid var(--border-card);border-radius:18px;padding:16px 12px;text-align:center;transition:all .3s ease;display:flex;flex-direction:column;align-items:center;box-sizing:border-box;box-shadow:var(--shadow-soft)}
.int-meta-item:hover{border-color:var(--blue);transform:translateY(-2px);box-shadow:var(--shadow-soft)}
.int-meta-ico{width:40px;height:40px;background:var(--blue-l);border-radius:10px;display:flex;align-items:center;justify-content:center;color:var(--blue);margin-bottom:10px;flex-shrink:0;transition:all .3s ease}
.int-meta-ico svg{margin:0;display:block}
.int-meta-item:hover .int-meta-ico{background:var(--blue);color:#fff}
.int-meta-txt{display:flex;flex-direction:column;align-items:center;gap:2px}
.int-meta-txt strong{display:block;font-size:13px;font-weight:700;color:var(--blue)}
.int-meta-txt span{font-size:11px;color:var(--muted)}
.int-benefits-title{font-size:11px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:var(--text-dark);margin-bottom:16px;display:flex;align-items:center;gap:10px}
.int-benefits-title::after{content:'';flex:1;height:1px;background:var(--border-card)}
.benefits-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
.benefit-item{background:var(--bg-cream-card);border:1px solid var(--border-card);border-radius:18px;padding:16px 18px;display:flex;align-items:center;gap:12px;transition:all .3s ease;box-shadow:var(--shadow-soft)}
.benefit-item:hover{border-color:var(--blue);box-shadow:var(--shadow-soft);transform:translateY(-2px)}
.ben-ico{width:40px;height:40px;background:var(--blue-l);border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;color:var(--blue)}
.ben-txt strong{display:block;font-size:13px;font-weight:700;color:var(--text-dark)}
.ben-txt span{font-size:11px;color:var(--muted)}

/* TEAM / LEADERSHIP SECTION BACKGROUND */
.team{background:linear-gradient(180deg,var(--bg-cream-card) 0%,var(--bg-cream) 40%,var(--bg-cream-alt) 100%);position:relative;overflow:hidden;border-top:1px solid var(--border-soft);border-bottom:1px solid var(--border-card)}
.team::before{content:'';position:absolute;top:-100px;left:50%;transform:translateX(-50%);width:1100px;height:500px;background:radial-gradient(ellipse at 50% 10%,rgba(40,69,238,0.06) 0%,rgba(34,211,238,0.03) 40%,transparent 70%);pointer-events:none}
.team-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.tc{background:var(--bg-cream-card);border:1px solid var(--border-card);border-radius:22px;padding:32px 26px;transition:all .3s ease;position:relative;overflow:hidden;box-shadow:var(--shadow-soft)}
.tc::after{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--grad);opacity:0;transition:opacity .3s}
.tc:hover{border-color:rgba(40,69,238,.25);box-shadow:var(--shadow-lg);transform:translateY(-5px)}
.tc:hover::after{opacity:1}
.tc-avatar{width:56px;height:56px;border-radius:16px;background:var(--grad);display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:800;color:#fff;margin-bottom:16px}
.tc h3{font-size:19px;font-weight:800;color:var(--text-dark);margin-bottom:8px;letter-spacing:-.5px}
.tc-tags{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:16px}
.tc-tag{font-size:10px;font-weight:700;letter-spacing:1px;text-transform:uppercase;padding:4px 12px;border-radius:50px}
.td{color:var(--blue);background:var(--blue-m)}
.tv{color:var(--purple);background:#ede9fe}
.ta{color:#0891b2;background:#cffafe}
.tg{color:#16a34a;background:#dcfce7}
.to{color:#ea580c;background:#ffedd5}
.tc-skills{display:flex;flex-direction:column;gap:8px}
.tc-skill{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--muted);font-weight:500}
.sk-dot{width:5px;height:5px;border-radius:50%;background:var(--blue);flex-shrink:0}

/* WHY US */
.why{background:linear-gradient(180deg,var(--bg-cream) 0%,var(--bg-cream-card) 50%,var(--bg-cream) 100%);position:relative}
.why-in{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}
.why-cards{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.wc{background:var(--bg-cream-card);border:1px solid var(--border-card);border-radius:22px;padding:28px 24px;transition:all .3s cubic-bezier(0.16,1,0.3,1);box-shadow:var(--shadow-soft)}
.wc:hover{border-color:var(--blue);box-shadow:var(--shadow-soft);transform:translateY(-3px);background:var(--bg-cream-soft)}
.wc-ico{width:60px;height:60px;background:var(--bg-cream-card);border:1px solid var(--border-card);border-radius:18px;display:flex;align-items:center;justify-content:center;margin-bottom:18px;box-shadow:0 8px 24px rgba(40,69,238,.14);transition:all .35s ease;position:relative;overflow:hidden}
.wc:hover .wc-ico{transform:scale(1.12) translateY(-2px) rotate(-3deg);box-shadow:0 14px 30px rgba(40,69,238,.24)}
.wc h4{font-size:16px;font-weight:700;color:var(--text-dark);margin-bottom:8px}
.wc p{font-size:13px;color:var(--muted);line-height:1.65}

/* MENTORSHIP */
.mentorship{background:linear-gradient(180deg,var(--bg-cream-card) 0%,var(--bg-cream) 50%,var(--bg-cream-alt) 100%);position:relative}
.mentor-badge{display:inline-flex;align-items:center;gap:8px;background:var(--blue-m);color:var(--blue);border-radius:50px;padding:6px 16px;font-size:11px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:16px}
.mentor-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:40px}
.mentor-card{background:var(--bg-cream-card);border:1px solid var(--border-card);border-radius:22px;padding:30px 22px;transition:all .3s cubic-bezier(0.16,1,0.3,1);position:relative;overflow:hidden;box-shadow:var(--shadow-soft)}
.mentor-card::after{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--grad);opacity:0;transition:opacity .3s}
.mentor-card:hover{border-color:var(--blue);box-shadow:var(--shadow-lg);transform:translateY(-5px)}
.mentor-card:hover::after{opacity:1}
.mentor-ico{width:56px;height:56px;border-radius:14px;display:flex;align-items:center;justify-content:center;margin-bottom:20px;background:var(--blue-l);border:1px solid var(--blue-m);color:var(--blue);transition:all .3s ease}
.mentor-card:hover .mentor-ico{background:linear-gradient(135deg,#2845EE,#1d35c7);color:#ffffff;border-color:transparent;transform:translateY(-2px);box-shadow:0 8px 20px rgba(40,69,238,.25)}
.mentor-ico svg{width:26px;height:26px;transition:transform .3s ease}
.mentor-card:hover .mentor-ico svg{transform:scale(1.08)}
.mentor-card h3{font-size:16px;font-weight:700;color:var(--text-dark);margin-bottom:8px;line-height:1.35}
.mentor-card p{font-size:12.5px;color:var(--muted);line-height:1.65}
.mentor-cta{margin-top:40px;background:linear-gradient(135deg,#0B1130,#1B1150 55%,#2A0F4A);border-radius:22px;padding:36px 40px;display:flex;align-items:center;justify-content:space-between;gap:28px;color:#fff;position:relative;overflow:hidden}
.mentor-cta::before{content:'';position:absolute;inset:0;background-image:radial-gradient(rgba(255,255,255,.09) 1px,transparent 1px);background-size:24px 24px;opacity:.5}
.mentor-cta-txt{position:relative;z-index:1;max-width:580px}
.mentor-cta-txt h3{font-size:clamp(20px,2.8vw,28px);font-weight:800;letter-spacing:-.5px;margin-bottom:0}
.mentor-cta-txt p{font-size:13.5px;color:#cbd5e1;line-height:1.6}
.mentor-cta-btn{position:relative;z-index:1;background:var(--grad);color:#fff;padding:12px 28px;border-radius:50px;font-size:13.5px;font-weight:700;white-space:nowrap;box-shadow:0 6px 20px rgba(40,69,238,.35);transition:all .2s;flex-shrink:0}
.mentor-cta-btn:hover{transform:translateY(-2px);box-shadow:0 8px 28px rgba(124,58,237,.45)}

/* HIRING */
.hiring{background:linear-gradient(160deg,#edf2fc 0%,var(--bg-cream) 100%)}
.hiring-badge{display:inline-flex;align-items:center;gap:8px;background:#dcfce7;color:#16a34a;border-radius:50px;padding:6px 16px;font-size:11px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:16px;animation:pulseGreen 2s infinite}
@keyframes pulseGreen{0%,100%{box-shadow:0 0 0 0 rgba(22,163,74,.3)}50%{box-shadow:0 0 0 8px rgba(22,163,74,0)}}
.hiring-in{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:start}
.hiring-left h2{font-size:clamp(28px,3.5vw,44px);font-weight:800;letter-spacing:-1px;margin-bottom:16px}
.hiring-left p{font-size:15px;color:var(--muted);line-height:1.8;margin-bottom:24px}
.positions-list{display:flex;flex-direction:column;gap:10px;margin-bottom:28px}
.pos-item{display:flex;align-items:center;gap:12px;padding:14px 18px;background:var(--bg-cream-card);border:1px solid var(--border-card);border-radius:16px;font-size:14px;font-weight:600;color:var(--text-dark);transition:all .3s ease;box-shadow:var(--shadow-soft)}
.pos-item:hover{border-color:var(--blue);box-shadow:var(--shadow-soft);transform:translateX(4px)}
.pos-dot{width:8px;height:8px;border-radius:50%;background:var(--blue);flex-shrink:0}
.hiring-right{display:grid;grid-template-columns:1fr;gap:16px}
.hr-box{background:var(--bg-cream-card);border:1px solid var(--border-card);border-radius:22px;padding:24px 28px;box-shadow:var(--shadow-soft)}
.hr-box-title{display:flex;align-items:center;gap:10px;font-size:12px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:var(--text-dark);margin-bottom:16px;padding-bottom:12px;border-bottom:1px solid var(--border-card)}
.hr-box-title svg{color:var(--blue)}
.hr-list{display:flex;flex-direction:column;gap:8px}
.hr-list li{display:flex;align-items:flex-start;gap:8px;font-size:13px;color:var(--muted);line-height:1.5}
.hr-list li::before{content:'•';color:var(--blue);font-weight:800;flex-shrink:0;margin-top:1px}

/* PARTNERSHIP */
.partner{background:linear-gradient(135deg,#0c2363 0%,#153ea8 40%,#1e50d8 75%,#1b3ca0 100%);position:relative;overflow:hidden;border-top:1px solid rgba(255,255,255,.2);border-bottom:1px solid rgba(255,255,255,.2);padding:90px 0}
.partner::before{content:'';position:absolute;top:-120px;right:-120px;width:500px;height:500px;background:radial-gradient(circle,rgba(34,211,238,.3),transparent 65%);pointer-events:none}
.partner::after{content:'';position:absolute;bottom:-120px;left:-120px;width:500px;height:500px;background:radial-gradient(circle,rgba(255,255,255,.15),transparent 65%);pointer-events:none}
.partner-in{display:grid;grid-template-columns:1.1fr .9fr;gap:56px;align-items:center;position:relative;z-index:1}
.partner-left h2{font-size:clamp(30px,3.8vw,46px);font-weight:900;color:#ffffff;letter-spacing:-1.2px;margin-bottom:18px;line-height:1.15}
.partner-left h2 .b-text{background:linear-gradient(135deg,#67e8f9 0%,#a5f3fc 50%,#ffffff 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.partner-left p.partner-lead{font-size:15px;color:#e0e7ff;line-height:1.8;margin-bottom:28px}
.partner-orgs{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-bottom:24px}
.org-card{background:rgba(255,255,255,.1);border:1.5px solid rgba(255,255,255,.2);border-radius:16px;padding:12px 14px;display:flex;align-items:center;gap:12px;backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);transition:all .28s cubic-bezier(0.16,1,0.3,1);box-shadow:0 8px 24px rgba(0,0,0,.15)}
.org-card:hover{border-color:#67e8f9;transform:translateY(-3px);background:rgba(255,255,255,.18);box-shadow:0 12px 30px rgba(0,0,0,.25)}
.org-card.org-card-lead{grid-column:1 / -1;background:linear-gradient(135deg,rgba(255,255,255,0.18) 0%,rgba(56,189,248,0.12) 100%);border-color:rgba(103,232,249,0.45)}
.org-card-ico{width:46px;height:46px;border-radius:12px;background:#ffffff;box-shadow:0 4px 14px rgba(0,0,0,.2);border:1px solid rgba(255,255,255,.6);padding:3px;display:flex;align-items:center;justify-content:center;flex-shrink:0;overflow:hidden}
.org-card-ico img{width:100%;height:100%;object-fit:contain;border-radius:8px}
.org-card-txt strong{display:block;font-size:13.5px;font-weight:800;color:#ffffff;line-height:1.25;margin-bottom:2px}
.org-card-txt span{display:block;font-size:10.5px;color:#cbd5e1;font-weight:500;line-height:1.3}
@media(max-width:640px){.partner-orgs{grid-template-columns:1fr;gap:10px}}
.partner-quote{background:rgba(255,255,255,.1);border-left:4px solid #38bdf8;border-radius:0 16px 16px 0;padding:20px 24px;border:1px solid rgba(255,255,255,.2);border-left:4px solid #38bdf8;backdrop-filter:blur(10px)}
.partner-quote p{font-size:13.5px;color:#f1f5f9;line-height:1.75;font-style:italic;margin:0}
.partner-quote strong{color:#67e8f9;font-style:normal}
.partner-obj{background:rgba(255,255,255,.1);border:1.5px solid rgba(255,255,255,.22);border-radius:22px;padding:28px 30px;backdrop-filter:blur(14px);box-shadow:0 24px 60px rgba(0,0,0,.2)}
.partner-obj-title{display:flex;align-items:center;gap:10px;font-size:11px;font-weight:800;letter-spacing:2.5px;text-transform:uppercase;color:#a5f3fc;margin-bottom:20px;padding-bottom:12px;border-bottom:1px solid rgba(255,255,255,.15)}
.partner-obj-title svg{color:#38bdf8}
.pobj-list{display:flex;flex-direction:column;gap:12px}
.pobj-item{display:flex;align-items:flex-start;gap:12px;font-size:13.5px;color:#f1f5f9;line-height:1.6}
.pobj-check{width:18px;height:18px;border-radius:50%;background:rgba(34,211,238,.25);border:1px solid #38bdf8;display:flex;align-items:center;justify-content:center;color:#67e8f9;flex-shrink:0;margin-top:2px}
.partner-reps{margin-top:18px;background:rgba(255,255,255,.1);border:1.5px solid rgba(255,255,255,.22);border-radius:22px;padding:24px 28px;backdrop-filter:blur(14px);box-shadow:0 24px 60px rgba(0,0,0,.2)}
.partner-reps-title{display:flex;align-items:center;gap:10px;font-size:11px;font-weight:800;letter-spacing:2.5px;text-transform:uppercase;color:#a5f3fc;margin-bottom:16px;padding-bottom:12px;border-bottom:1px solid rgba(255,255,255,.15)}
.partner-reps-title svg{color:#38bdf8}
.partner-reps-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.rep-box{background:rgba(255,255,255,.08);border-radius:14px;padding:16px 18px;border:1px solid rgba(255,255,255,.18);display:flex;align-items:center;gap:14px;transition:all .3s ease}
.rep-box:hover{border-color:#67e8f9;background:rgba(255,255,255,.16);transform:translateY(-2px);box-shadow:0 8px 24px rgba(0,0,0,.2)}
.rep-avatar{width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:15px;font-weight:800;color:#fff;flex-shrink:0;overflow:hidden}
.rep-avatar img{width:100%;height:100%;object-fit:cover;object-position:top center;display:block}
.rep-av-1{background:#ffffff;box-shadow:0 4px 12px rgba(0,0,0,.2);border:1px solid rgba(255,255,255,.4)}
.rep-av-2{background:#ffffff;box-shadow:0 4px 12px rgba(0,0,0,.2);border:1px solid rgba(255,255,255,.4)}
.rep-av-3{background:#ffffff;box-shadow:0 4px 12px rgba(0,0,0,.2);border:1px solid rgba(255,255,255,.4)}
.rep-av-4{background:#ffffff;box-shadow:0 4px 12px rgba(0,0,0,.2);border:1px solid rgba(255,255,255,.4)}
.rep-av-5{background:#ffffff;box-shadow:0 4px 12px rgba(0,0,0,.2);border:1px solid rgba(255,255,255,.4)}
.rep-info strong{display:block;font-size:14px;font-weight:800;color:#ffffff;margin-bottom:2px}
.rep-info span{font-size:11px;color:#cbd5e1;line-height:1.35;display:block}

/* COURSERA-STYLE CLEAN ROW CAROUSEL */
.courses{background:var(--bg-cream);padding:24px 0}
.courses-intro{font-size:14px;color:var(--text-sub);max-width:820px;line-height:1.6;margin-bottom:28px}
.courses-grid-row{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:20px;
  width:100%;
  margin-bottom:28px;
}
.coursera-card{
  background:var(--bg-cream-card);
  border:1px solid var(--border-card);
  border-radius:18px;
  overflow:hidden;
  display:flex;
  flex-direction:column;
  text-decoration:none;
  color:var(--text-dark);
  transition:all .25s ease;
  box-shadow:var(--shadow-soft);
}
.coursera-card:hover{
  border-color:var(--blue);
  transform:translateY(-4px);
  box-shadow:var(--shadow-lg);
}
.coursera-thumb{
  width:100%;
  height:148px;
  overflow:hidden;
  background:#0f172a;
}
.coursera-thumb img{
  width:100%;
  height:100%;
  object-fit:cover;
  object-position:center;
  transition:transform .4s ease;
}
.coursera-card:hover .coursera-thumb img{
  transform:scale(1.04);
}
.coursera-body{
  padding:14px 16px 16px;
  display:flex;
  flex-direction:column;
  flex:1;
}
.coursera-org{
  display:flex;
  align-items:center;
  gap:8px;
  margin-bottom:8px;
}
.coursera-org-ico{
  width:22px;
  height:22px;
  border-radius:4px;
  object-fit:contain;
  border:1px solid var(--border-card);
  flex-shrink:0;
}
.coursera-org-name{
  font-size:12px;
  color:var(--text-sub);
  font-weight:500;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}
.coursera-title{
  font-size:14.5px;
  font-weight:700;
  color:var(--text-dark);
  line-height:1.35;
  margin-bottom:10px;
  min-height:38px;
  display:-webkit-box;
  -webkit-line-clamp:2;
  -webkit-box-orient:vertical;
  overflow:hidden;
}
.coursera-type{
  font-size:11.5px;
  color:var(--muted);
  margin-bottom:14px;
  font-weight:500;
}
.coursera-pill{
  display:inline-flex;
  align-items:center;
  padding:4px 12px;
  border:1px solid var(--border-card);
  border-radius:50px;
  font-size:11.5px;
  font-weight:600;
  color:var(--text-dark);
  background:var(--bg-cream-soft);
  box-shadow:var(--shadow-inset);
  width:fit-content;
  margin-top:auto;
}

/* Show more button (Coursera blue outline button) */
.coursera-btn-row{
  display:flex;
  gap:12px;
  align-items:center;
  flex-wrap:wrap;
  margin-top:6px;
}
.btn-coursera-more{
  display:inline-flex;
  align-items:center;
  gap:8px;
  padding:11px 26px;
  background:var(--grad-blue);
  color:#ffffff !important;
  border-radius:50px;
  font-size:13.5px;
  font-weight:800;
  text-decoration:none;
  transition:all .25s ease;
  box-shadow:0 6px 20px rgba(40,69,238,0.25),inset 0 1px 0 rgba(255,255,255,0.35);
  border:none;
}
.btn-coursera-more:hover{
  background:linear-gradient(135deg, #1d35c7, #152696);
  transform:translateY(-2px);
  box-shadow:0 10px 28px rgba(40,69,238,0.38);
  color:#ffffff !important;
}
.btn-coursera-form{
  display:inline-flex;
  align-items:center;
  gap:8px;
  padding:10.5px 22px;
  background:var(--bg-cream-soft);
  color:var(--blue) !important;
  border:1.5px solid var(--blue);
  border-radius:50px;
  font-size:13.5px;
  font-weight:700;
  text-decoration:none;
  transition:all .25s ease;
  box-shadow:var(--shadow-soft);
}
.btn-coursera-form:hover{
  background:rgba(40,69,238,0.06);
  transform:translateY(-1px);
}
.coursera-card.coursera-more-card{
  display:flex !important;
  flex-direction:column !important;
  align-items:center !important;
  justify-content:center !important;
  background:transparent !important;
  border:none !important;
  box-shadow:none !important;
  outline:none !important;
  padding:0 !important;
  text-decoration:none !important;
  min-height:260px !important;
  height:100% !important;
  flex:0 0 200px !important;
  align-self:stretch !important;
}
.coursera-card.coursera-more-card:hover{
  background:transparent !important;
