.ft-desc{font-size:14px;color:#cbd5e1;line-height:1.75;max-width:380px}
.ft-col h4{font-size:12px;font-weight:800;color:#fff;letter-spacing:2px;text-transform:uppercase;margin-bottom:18px}
.ft-col a{display:block;font-size:14px;color:#94a3b8;margin-bottom:10px;transition:all .2s ease;font-weight:500}
