/* CHATBOT */
.cfab{position:fixed;bottom:28px;right:28px;width:56px;height:56px;background:#0c1c4f;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;z-index:997;box-shadow:0 8px 30px rgba(59,91,255,.45);transition:all .35s cubic-bezier(0.16,1,0.3,1);border:2px solid #38bdf8;padding:2px;overflow:hidden}
.cfab:hover{transform:scale(1.08) translateY(-2px);box-shadow:0 14px 40px rgba(59,91,255,.6);border-color:#60a5fa}
.cfab.active{transform:scale(0.95);box-shadow:0 4px 18px rgba(59,91,255,.4);border-color:#60a5fa}
.cfab img{width:100%;height:100%;object-fit:cover;border-radius:50%;display:block;transition:transform .35s cubic-bezier(0.16,1,0.3,1)}
.cfab:hover img{transform:scale(1.05)}
.cwin{position:fixed;bottom:96px;right:28px;width:340px;background:var(--bg-cream-card);border-radius:24px;box-shadow:0 24px 80px rgba(15,23,42,.18),0 4px 20px rgba(40,69,238,.12);z-index:996;display:flex;flex-direction:column;overflow:hidden;border:1px solid var(--border-card);max-height:480px;opacity:0;visibility:hidden;pointer-events:none;transform:scale(0.82) translateY(24px);transform-origin:bottom right;transition:opacity .28s cubic-bezier(0.4,0,0.2,1),transform .32s cubic-bezier(0.4,0,0.2,1),visibility .32s cubic-bezier(0.4,0,0.2,1);will-change:transform,opacity}
.cwin.open{opacity:1;visibility:visible;pointer-events:auto;transform:scale(1) translateY(0);transition:opacity .36s cubic-bezier(0.16,1,0.3,1),transform .4s cubic-bezier(0.16,1,0.3,1),visibility .4s cubic-bezier(0.16,1,0.3,1)}
.ch{background:linear-gradient(135deg,#0c2363,#1e50d8);padding:16px 18px;display:flex;align-items:center;justify-content:space-between}
.ch-l{display:flex;align-items:center;gap:12px}
.ch-av{width:42px;height:42px;background:#080e22;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 0 14px rgba(34,211,238,.5);border:2px solid #38bdf8;overflow:hidden;padding:0}
