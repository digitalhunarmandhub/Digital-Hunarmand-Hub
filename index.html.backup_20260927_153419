.int-badge{display:inline-flex;align-items:center;gap:8px;background:var(--blue);color:#fff;border-radius:50px;padding:8px 20px;font-size:12px;font-weight:700;letter-spacing:1px;text-transform:uppercase;margin-bottom:20px}
