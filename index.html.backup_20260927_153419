function startHeroTyping() {
  var line1 = document.getElementById('typeLine1');
  var line2 = document.getElementById('typeLine2');
  var line3 = document.getElementById('typeLine3');
  var line4 = document.getElementById('typeLine4');
  var cursor = document.getElementById('typeCursor');
  
  if (!line1 || !line2 || !line3 || !line4) return;
  if (line1.dataset.typed === "true") return;
  line1.dataset.typed = "true";
  
  var text1 = "We Build";
  var text2 = "Digital Solutions";
  var text3 = "That Grow Your";
  var text4 = "Business";
  var speed = 45;
  
  function typeText(element, text, callback) {
    var i = 0;
    var timer = setInterval(function() {
      element.textContent += text.charAt(i);
      i++;
      if (i >= text.length) {
        clearInterval(timer);
        if (callback) callback();
      }
    }, speed);
  }
  
  typeText(line1, text1, function() {
    typeText(line2, text2, function() {
      typeText(line3, text3, function() {
        typeText(line4, text4, function() {
          if (cursor) cursor.remove();
          setTimeout(function() {
            line2.classList.add('active');
          }, 150);
        });
      });
    });
  });
}

// ── INTERACTIVE MOUSE PARALLAX FOR HERO BUBBLES & ORBS ──
(function(){
  var hero = document.getElementById('home');
  var heroDeco = document.getElementById('heroDeco');
  if (!hero || !heroDeco || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  var mouseX = 0, mouseY = 0;
  var currentX = 0, currentY = 0;

  hero.addEventListener('mouseleave', function(){
    mouseX = 0;
    mouseY = 0;
  });

  hero.addEventListener('mousemove', function(e){
    var rect = hero.getBoundingClientRect();
    var x = e.clientX - rect.left - rect.width / 2;
    var y = e.clientY - rect.top - rect.height / 2;
    mouseX = x / (rect.width / 2);
    mouseY = y / (rect.height / 2);
  }, {passive: true});

  function renderParallax(){
    currentX += (mouseX - currentX) * 0.05;
    currentY += (mouseY - currentY) * 0.05;

    if (Math.abs(currentX) > 0.001 || Math.abs(currentY) > 0.001) {
      heroDeco.style.transform = 'translate3d(' + (currentX * 22).toFixed(2) + 'px,' + (currentY * 22).toFixed(2) + 'px,0)';
    }

    requestAnimationFrame(renderParallax);
  }

  if (window.matchMedia('(pointer: fine)').matches) {
    requestAnimationFrame(renderParallax);
  }
})();
</script>

