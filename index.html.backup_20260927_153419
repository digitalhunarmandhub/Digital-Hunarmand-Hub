      } else {
        d.classList.remove('active');
      }
    });
  }

  /* Sync active dot and card highlighting with scroll position */
  function syncActiveCardOnScroll(){
    if(!isCarouselActive()){
      cards.forEach(function(card){
        card.classList.remove('cube-active');
      });
      return;
    }

    var scrollLeft = grid.scrollLeft;
    var containerCenter = scrollLeft + grid.clientWidth / 2;
    var closestIdx = 0;
    var minDiff = Infinity;

    cards.forEach(function(card, i){
      var cardCenter = card.offsetLeft + card.offsetWidth / 2;
      var absDiff = Math.abs(cardCenter - containerCenter);
      if(absDiff < minDiff){
        minDiff = absDiff;
        closestIdx = i;
      }
    });

    if(closestIdx !== currentIndex){
      currentIndex = closestIdx;
      updateActiveStates(currentIndex);
    }
  }

  function goToMember(idx, smooth){
    if(idx < 0) idx = 0;
    if(idx >= cards.length) idx = cards.length - 1;

    currentIndex = idx;
    updateActiveStates(currentIndex);

    var targetLeft = getScrollLeftForIndex(currentIndex);
    grid.scrollTo({
      left: targetLeft,
      behavior: smooth !== false ? 'smooth' : 'auto'
    });
  }

  // Smooth scroll sync with requestAnimationFrame
  grid.addEventListener('scroll', function(){
    if(!isCarouselActive()) return;
    if(rafId) cancelAnimationFrame(rafId);
    rafId = requestAnimationFrame(syncActiveCardOnScroll);
  }, {passive: true});

  // Dot Navigation
  dots.forEach(function(dot){
    dot.addEventListener('click', function(e){
      e.stopPropagation();
      var targetIdx = parseInt(dot.getAttribute('data-index'), 10);
      if(!isNaN(targetIdx)){
        goToMember(targetIdx, true);
      }
    });
  });

  // Next / Prev Buttons
  if(prevBtn){
    prevBtn.addEventListener('click', function(e){
      e.stopPropagation();
      goToMember(currentIndex - 1, true);
    });
  }
  if(nextBtn){
    nextBtn.addEventListener('click', function(e){
      e.stopPropagation();
      goToMember(currentIndex + 1, true);
    });
  }

  // Keyboard navigation when focusing inside carousel
  grid.addEventListener('keydown', function(e){
    if(!isCarouselActive()) return;
    if(e.key === 'ArrowRight'){
      goToMember(currentIndex + 1, true);
    } else if(e.key === 'ArrowLeft'){
      goToMember(currentIndex - 1, true);
    }
  });

  // Initialize
  function init(){
    if(isCarouselActive()){
      goToMember(0, false);
      syncActiveCardOnScroll();
    }
  }

  if(document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  window.addEventListener('resize', function(){
    if(isCarouselActive()){
      goToMember(currentIndex, false);
      syncActiveCardOnScroll();
    } else {
      syncActiveCardOnScroll();
    }
  });
})();
</script>

