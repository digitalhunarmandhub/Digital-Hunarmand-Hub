<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Digital Hunarmand</title>
<link rel="icon" type="image/png" href="favicon.png"/>
<link rel="shortcut icon" href="favicon.png"/>
<link rel="apple-touch-icon" href="favicon.png"/>
<meta name="description" content="A Complete Digital Solution for Business & Individual Success."/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet"/>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'Space Grotesk',sans-serif;background:var(--bg-cream);color:var(--text-dark);overflow-x:hidden;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;text-rendering:optimizeLegibility}
a{text-decoration:none;color:inherit}
ul{list-style:none}
img{max-width:100%;display:block}
:root{
  --blue:#2845EE;--blue-d:#1d35c7;--blue-l:#dce5fc;--blue-m:#c9d7fb;
  --purple:#7c3aed;--dark:#131826;--muted:#556275;--border:#d5dbe5;
  --cyan:#0ea5e9;
  --bg-cream:#ebedf2;--bg-cream-card:#ebedf2;--bg-cream-alt:#e2e6ec;--bg-cream-soft:#f2f4f8;
  --border-soft:rgba(255,255,255,0.75);--border-card:rgba(255,255,255,0.9);
  --text-dark:#131826;--text-sub:#4a5568;
  --grad:linear-gradient(135deg,#2845EE,#7c3aed);
  --grad-blue:linear-gradient(135deg,#2845EE 0%,#1e38d6 100%);
  --grad-dark:linear-gradient(135deg,#131826,#1e293b);
  --shadow:10px 12px 26px rgba(166,175,195,0.42), -10px -10px 24px #ffffff;
  --shadow-lg:14px 18px 34px rgba(166,175,195,0.48), -12px -12px 28px #ffffff;
  --shadow-soft:6px 8px 18px rgba(166,175,195,0.38), -6px -6px 16px #ffffff;
  --shadow-inset:inset 4px 4px 9px rgba(166,175,195,0.45), inset -4px -4px 9px #ffffff;
  --mono:'JetBrains Mono',monospace;
}
.g-text{background:var(--grad);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.sw{max-width:1240px;margin:0 auto;padding:96px 32px}
.sl{font-family:var(--mono);font-size:11px;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;color:var(--blue);margin-bottom:12px;display:inline-block}
.st{font-size:clamp(30px,4vw,48px);font-weight:800;line-height:1.08;color:var(--text-dark);margin-bottom:16px;letter-spacing:-1px}
.st.w{color:#fff}
.ss{font-size:16px;color:var(--muted);max-width:560px;line-height:1.8}
.ss.w{color:#94a3b8}
.center{text-align:center}
.center .ss{margin:0 auto}
.reveal{opacity:0;transform:translateY(24px);transition:opacity .7s ease,transform .7s ease}
.reveal-l{opacity:0;transform:translateX(-28px);transition:opacity .7s ease,transform .7s ease}
.reveal-r{opacity:0;transform:translateX(28px);transition:opacity .7s ease,transform .7s ease}
.reveal.v,.reveal-l.v,.reveal-r.v{opacity:1;transform:none}

/* MOBILE HERO TERMINAL */
.hero-mobile-term{display:none;margin-top:8px}
.scroll-progress{position:fixed;top:0;left:0;height:3px;width:0%;background:var(--grad);z-index:2100;transition:width .1s linear}

/* PHOTO BANNER MOTION */
.photo-banner{position:relative;min-height:360px;overflow:hidden;background:linear-gradient(135deg,#060919 0%,#0f1742 35%,#1f104d 70%,#090d24 100%);background-size:250% 250%;animation:pbBgMotion 6s ease-in-out infinite alternate;display:flex;align-items:center}
@keyframes pbBgMotion{0%{background-position:0% 20%}50%{background-position:100% 80%}100%{background-position:0% 20%}}
.photo-banner::before{content:'';position:absolute;inset:0;background-image:radial-gradient(rgba(255,255,255,.18) 1.5px,transparent 1.5px);background-size:26px 26px;opacity:.5;animation:pbGridMove 8s linear infinite}
@keyframes pbGridMove{0%{background-position:0 0}100%{background-position:52px 52px}}
.pb-glow{position:absolute;border-radius:50%;filter:blur(60px);opacity:.7;pointer-events:none}
.pb-glow.g1{width:440px;height:440px;background:#2845EE;top:-80px;left:-60px;animation:orbFloat1 4.5s ease-in-out infinite alternate}
.pb-glow.g2{width:400px;height:400px;background:#8B3EF2;bottom:-100px;right:-40px;animation:orbFloat2 5s ease-in-out infinite alternate}
.pb-glow.g3{width:300px;height:300px;background:#22D3EE;top:25%;left:45%;opacity:.5;animation:orbFloat3 4s ease-in-out infinite alternate}
.pb-glow.g4{width:300px;height:300px;background:#ec4899;bottom:10%;left:15%;opacity:.4;animation:orbFloat4 4.8s ease-in-out infinite alternate}
@keyframes orbFloat1{0%{transform:translate(0,0) scale(0.95)}100%{transform:translate(120px,70px) scale(1.25)}}
@keyframes orbFloat2{0%{transform:translate(0,0) scale(1)}100%{transform:translate(-130px,-80px) scale(1.3)}}
@keyframes orbFloat3{0%{transform:translate(-50%,-50%) scale(0.9)}100%{transform:translate(-20%,-20%) scale(1.4)}}
@keyframes orbFloat4{0%{transform:translate(0,0) scale(1)}100%{transform:translate(90px,-70px) scale(1.3)}}
.pb-particles{position:absolute;inset:0;pointer-events:none;overflow:hidden}
.p-dot{position:absolute;border-radius:50%;background:#fff;opacity:.6;animation:pFloat 3s ease-in-out infinite alternate}
.p1{width:5px;height:5px;top:20%;left:15%;animation-duration:2.5s;animation-delay:0s;box-shadow:0 0 10px #60a5fa}
.p2{width:6px;height:6px;top:65%;left:25%;animation-duration:3.2s;animation-delay:.4s;box-shadow:0 0 14px #c084fc}
.p3{width:5px;height:5px;top:30%;left:80%;animation-duration:2.8s;animation-delay:.8s;box-shadow:0 0 10px #22d3ee}
.p4{width:6px;height:6px;top:70%;left:75%;animation-duration:3.5s;animation-delay:.3s;box-shadow:0 0 14px #818cf8}
.p5{width:5px;height:5px;top:15%;left:60%;animation-duration:2.6s;animation-delay:.6s;box-shadow:0 0 10px #38bdf8}
.p6{width:7px;height:7px;top:45%;left:90%;animation-duration:3.8s;animation-delay:1s;box-shadow:0 0 16px #f472b6}
@keyframes pFloat{0%{transform:translateY(0) scale(1);opacity:.4}100%{transform:translateY(-35px) scale(1.6);opacity:1}}
.photo-banner .pb-overlay{position:relative;z-index:2;width:100%;display:flex;align-items:center;justify-content:center;padding:64px 20px}
.photo-banner .pb-in{text-align:center;color:#fff;max-width:960px;width:100%}
.pb-title{font-size:clamp(26px,4vw,46px);font-weight:800;letter-spacing:-1px;margin-bottom:38px;line-height:1.2;background:linear-gradient(90deg,#ffffff 0%,#93c5fd 25%,#e9d5ff 50%,#93c5fd 75%,#ffffff 100%);background-size:200% auto;-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;animation:titleShimmer 4s linear infinite}
@keyframes titleShimmer{0%{background-position:0% center}100%{background-position:200% center}}
.pb-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:22px;justify-content:center;max-width:920px;margin:0 auto}
.pb-stat{background:rgba(255,255,255,.07);border:1.5px solid rgba(255,255,255,.18);backdrop-filter:blur(16px);border-radius:22px;padding:28px 22px;text-align:center;position:relative;overflow:hidden;box-shadow:0 14px 40px rgba(0,0,0,.35),inset 0 1px 1px rgba(255,255,255,.2);transition:all .3s cubic-bezier(0.2,0.8,0.2,1)}
.pb-stat::before{content:'';position:absolute;top:-50%;left:-50%;width:200%;height:200%;background:radial-gradient(circle,rgba(255,255,255,.15) 0%,transparent 60%);opacity:0;transition:opacity .3s ease;pointer-events:none}
.pb-stat:hover::before{opacity:1}
.pb-stat-1{animation:floatCard1 2.8s ease-in-out infinite alternate}
.pb-stat-2{animation:floatCard2 3.1s ease-in-out infinite alternate;animation-delay:.3s}
.pb-stat-3{animation:floatCard3 2.7s ease-in-out infinite alternate;animation-delay:.6s}
.pb-stat-4{animation:floatCard4 3.3s ease-in-out infinite alternate;animation-delay:.9s}
@keyframes floatCard1{0%{transform:translateY(0) rotate(0deg);box-shadow:0 10px 30px rgba(59,91,255,.25)}100%{transform:translateY(-14px) rotate(-1deg);box-shadow:0 22px 48px rgba(59,91,255,.45)}}
@keyframes floatCard2{0%{transform:translateY(0) rotate(0deg);box-shadow:0 10px 30px rgba(139,62,242,.25)}100%{transform:translateY(-16px) rotate(1.2deg);box-shadow:0 24px 52px rgba(139,62,242,.45)}}
@keyframes floatCard3{0%{transform:translateY(0) rotate(0deg);box-shadow:0 10px 30px rgba(34,211,238,.2)}100%{transform:translateY(-13px) rotate(-1deg);box-shadow:0 20px 45px rgba(34,211,238,.4)}}
@keyframes floatCard4{0%{transform:translateY(0) rotate(0deg);box-shadow:0 10px 30px rgba(236,72,153,.25)}100%{transform:translateY(-15px) rotate(1deg);box-shadow:0 22px 50px rgba(236,72,153,.45)}}
.pb-stat:hover{background:rgba(255,255,255,.14);border-color:rgba(96,165,250,.8);transform:translateY(-20px) scale(1.06) !important;box-shadow:0 28px 60px rgba(59,91,255,.5) !important}
.pb-stat strong{display:block;font-size:clamp(30px,3.8vw,48px);font-weight:800;letter-spacing:-1.5px;line-height:1.05;margin-bottom:8px;background:linear-gradient(135deg,#60a5fa,#c084fc,#38bdf8);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;text-shadow:0 0 25px rgba(96,165,250,.4)}
.pb-stat span{font-size:12px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:#cbd5e1;display:block}
@media(max-width:768px){.pb-stats{grid-template-columns:repeat(2,1fr);gap:16px}.pb-stat{padding:22px 16px}}
@media(max-width:420px){.pb-stats{grid-template-columns:1fr 1fr;gap:12px}.pb-stat strong{font-size:26px}.pb-stat span{font-size:10.5px}}

/* TILT */
.tilt{transform-style:preserve-3d;transition:transform .15s ease}

/* NAV - Pure Neumorphic Soft UI Theme */
.nav{
  position:fixed;
  top:14px;
  left:20px;
  right:20px;
  z-index:1000;
  background:linear-gradient(145deg, #f7f9fd 0%, #e5e9f2 100%);
  border-radius:50px;
  border:1.5px solid rgba(255,255,255,0.95);
  box-shadow:14px 18px 38px rgba(150,164,188,0.46), 6px 8px 16px rgba(150,164,188,0.22), -10px -10px 24px #ffffff, -4px -4px 10px rgba(255,255,255,0.8), inset 1.5px 1.5px 2px rgba(255,255,255,0.95), inset -1.5px -1.5px 2px rgba(150,164,188,0.18);
  transition:all .35s cubic-bezier(0.16,1,0.3,1);
  overflow:visible;
}
.nav.menu-open{
  overflow:visible!important;
}
.nav::before,
.nav::after{
  content:none;
  display:none;
}
.nav.s{
  background:linear-gradient(145deg, #f8fafd 0%, #e2e7f0 100%);
  border-color:rgba(255,255,255,1);
  box-shadow:16px 22px 42px rgba(148,162,186,0.52), 6px 9px 18px rgba(148,162,186,0.26), -12px -12px 28px #ffffff, inset 1.5px 1.5px 2px #ffffff;
}
.nav-in{width:100%;max-width:100%;margin:0;padding:0 16px 0 18px;height:66px;display:flex;align-items:center;justify-content:space-between;gap:10px;position:relative;z-index:2;min-width:0;box-sizing:border-box}
.nav-logo{display:flex;align-items:center;gap:10px;flex-shrink:0;text-decoration:none;margin-right:6px}
.nav-ico{width:40px;height:40px;object-fit:contain;background:linear-gradient(145deg, #ffffff 0%, #e6ebf3 100%);border-radius:12px;padding:3px;border:1.5px solid rgba(255,255,255,0.95);box-shadow:4px 5px 12px rgba(155,168,192,0.42), -3px -3px 8px #ffffff, inset 0 1px 1.5px #ffffff;mix-blend-mode:normal;transition:all .28s cubic-bezier(0.16,1,0.3,1)}
.nav-logo:hover .nav-ico{transform:translateY(-2px) scale(1.05);box-shadow:6px 8px 16px rgba(150,164,188,0.48), -4px -4px 10px #ffffff}
.nav-txt strong{font-size:14.5px;font-weight:800;color:#131826;display:block;line-height:1.2;letter-spacing:-0.3px;white-space:nowrap}
.nav-txt strong em{color:var(--blue);font-style:normal}
.nav-txt small{font-size:10px;color:#64748b;font-weight:600;letter-spacing:0.2px;display:block;white-space:nowrap}
.nav-ul{display:flex;align-items:center;gap:2px;margin:0 0 0 auto;background:linear-gradient(145deg, #ffffff 0%, #e8ecf6 100%);border:1.5px solid rgba(255,255,255,0.95);border-radius:50px;padding:4px 6px;box-shadow:5px 7px 18px rgba(140,155,180,0.42), 2px 3px 6px rgba(140,155,180,0.2), -4px -4px 10px #ffffff, inset 1px 1px 2px rgba(255,255,255,0.95), inset -1px -1px 2px rgba(140,155,180,0.15);transition:all .3s cubic-bezier(0.16,1,0.3,1);max-width:calc(100% - 195px);overflow-x:auto;scrollbar-width:none;-ms-overflow-style:none;flex-shrink:1;white-space:nowrap}
.nav-ul::-webkit-scrollbar{display:none}
.nav-ul:hover{box-shadow:6px 9px 22px rgba(135,150,178,0.48), 2px 3px 7px rgba(135,150,178,0.25), -5px -5px 12px #ffffff, inset 1px 1px 2px rgba(255,255,255,1)}
.nav-ul a{display:inline-flex;align-items:center;gap:3.5px;font-size:11px;font-weight:650;color:#475569;padding:5px 8px;border-radius:50px;border:1px solid transparent;background:transparent;box-shadow:none;transition:all .22s cubic-bezier(0.16,1,0.3,1);white-space:nowrap;text-decoration:none;user-select:none}
.nav-ul a svg{width:12px;height:12px;flex-shrink:0;color:#64748b;transition:all .22s cubic-bezier(0.16,1,0.3,1)}
.nav-ul a:hover{color:var(--blue);background:#ffffff;border-color:rgba(255,255,255,0.9);box-shadow:2px 4px 9px rgba(145,158,182,0.38), -2px -2px 6px #ffffff, inset 0 1px 1px #ffffff;transform:translateY(-1px)}
.nav-ul a:hover svg{color:var(--blue);transform:scale(1.15)}
.nav-ul a:active{background:#e2e6f0;box-shadow:inset 2px 2px 5px rgba(140,155,180,0.5), inset -2px -2px 5px #ffffff;transform:translateY(0.5px) scale(0.98)}
.nav-ul a.on{background:linear-gradient(145deg, #3d75fd 0%, #2558ea 50%, #1742d4 100%);color:#ffffff;border-color:transparent;box-shadow:3px 5px 14px rgba(23,66,212,0.46), 0 2px 4px rgba(15,23,42,0.12), -2px -2px 6px rgba(255,255,255,0.8), inset 0 2px 3px rgba(255,255,255,0.55), inset 0 -2px 4px rgba(10,25,110,0.45);text-shadow:0 1px 2px rgba(10,25,90,0.35);font-weight:700;transform:translateY(-0.5px)}
.nav-ul a.on svg{color:#ffffff;transform:scale(1.1);filter:drop-shadow(0 1px 2px rgba(10,25,90,0.3))}
.nav-ul a.on:hover{background:linear-gradient(145deg, #4880ff 0%, #2c60f2 50%, #1a47dc 100%);box-shadow:4px 7px 18px rgba(23,66,212,0.52), -2px -2px 6px rgba(255,255,255,0.9), inset 0 2px 3px rgba(255,255,255,0.65), inset 0 -2px 4px rgba(10,25,110,0.5);transform:translateY(-1px);color:#ffffff}
.nav-ul a.on:active{box-shadow:inset 3px 3px 6px rgba(8,20,95,0.65), inset -2px -2px 5px rgba(255,255,255,0.35);transform:translateY(0.5px) scale(0.98)}
.nav-btn{background:linear-gradient(145deg, #3d75fd 0%, #2558ea 50%, #1742d4 100%);color:#ffffff;box-shadow:5px 7px 18px rgba(23,66,212,0.42), -3px -3px 8px #ffffff, inset 0 2px 3px rgba(255,255,255,0.5), inset 0 -2px 4px rgba(10,25,110,0.45);border:none;border-radius:50px;font-weight:700;transition:all .25s ease}
.nav-btn:hover{transform:translateY(-2px) scale(1.03);box-shadow:6px 9px 22px rgba(23,66,212,0.5), -4px -4px 10px #ffffff, inset 0 2px 4px rgba(255,255,255,0.6)}
.nav-btn:active{transform:translateY(0.5px) scale(0.98);box-shadow:inset 3px 3px 6px rgba(8,20,95,0.6), inset -2px -2px 5px rgba(255,255,255,0.3)}
.hbg{
  display:none;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  width:40px;
  height:40px;
  background:linear-gradient(135deg, rgba(255,255,255,0.85) 0%, rgba(238,244,255,0.55) 50%, rgba(220,235,255,0.75) 100%);
  backdrop-filter:blur(16px) saturate(180%);
  -webkit-backdrop-filter:blur(16px) saturate(180%);
  border:1.5px solid rgba(255,255,255,0.95);
  border-radius:12px;
  box-shadow:0 6px 18px -2px rgba(59,91,255,0.18), 0 2px 6px rgba(15,23,42,0.06), inset 0 1px 2px rgba(255,255,255,1), inset 0 -1px 2px rgba(59,91,255,0.14);
  cursor:pointer;
  padding:0;
  margin-left:auto;
  gap:5px;
  transition:all .3s cubic-bezier(0.4,0,0.2,1);
  position:relative;
  z-index:10005;
  pointer-events:auto;
  -webkit-tap-highlight-color:transparent;
  touch-action:manipulation;
}
.hbg:hover{
  background:linear-gradient(135deg, rgba(255,255,255,0.95) 0%, rgba(228,239,255,0.75) 100%);
  border-color:rgba(255,255,255,1);
  box-shadow:0 8px 24px -2px rgba(59,91,255,0.28), inset 0 1px 2px rgba(255,255,255,1), inset 0 -1px 2px rgba(59,91,255,0.22);
  transform:scale(1.04);
}
.hbg span{
  display:block;
  width:20px;
  height:2.2px;
  background:var(--text-dark);
  border-radius:3px;
  transition:all .3s cubic-bezier(0.4,0,0.2,1);
  transform-origin:center;
  pointer-events:none;
}
.hbg.active{
  background:linear-gradient(135deg, rgba(238,244,255,0.95) 0%, rgba(215,232,255,0.85) 100%);
  border-color:rgba(59,91,255,0.4);
  box-shadow:0 6px 22px -2px rgba(59,91,255,0.3), inset 0 1px 2px rgba(255,255,255,1);
}
.hbg.active span:nth-child(1){
  transform:translateY(7px) rotate(45deg);
  background:var(--blue);
}
.hbg.active span:nth-child(2){
  opacity:0;
  transform:scaleX(0);
}
.hbg.active span:nth-child(3){
  transform:translateY(-7px) rotate(-45deg);
  background:var(--blue);
}

/* Mobile Navigation Backdrop Overlay */
.nav-overlay{
  position:fixed;
  inset:0;
  background:rgba(8,11,22,0.48);
  backdrop-filter:blur(8px);
  -webkit-backdrop-filter:blur(8px);
  z-index:9990;
  opacity:0;
  visibility:hidden;
  pointer-events:none;
  transition:opacity .35s cubic-bezier(0.16,1,0.3,1), visibility .35s ease, backdrop-filter .35s ease;
}
.nav-overlay.open{
  opacity:1;
  visibility:visible;
  pointer-events:auto;
}
body.nav-open-lock{
  overflow:hidden!important;
}

/* HERO */
.hero{
  min-height:100vh;
  margin-top:0;
  background-color:var(--bg-cream);
  background-image:
    linear-gradient(to right, rgba(45,38,28,0.04) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(45,38,28,0.04) 1px, transparent 1px);
  background-size:46px 46px;
  background-position:-1px -1px;
  position:relative;
  overflow:hidden;
  display:flex;
  align-items:center;
  padding:118px 0 60px;
}
.hero-deco{position:absolute;inset:0;pointer-events:none;overflow:hidden;z-index:0}

/* HERO GLOW ORBS - LIVE FLOATING BACKGROUND BLOBS */
.hero-glow-orb{position:absolute;border-radius:50%;pointer-events:none;will-change:transform}
.hero-glow-orb.orb-1{
  width:620px;height:620px;
  background:radial-gradient(circle at 40% 40%, rgba(40,69,238,0.16) 0%, rgba(147,197,253,0.1) 45%, transparent 72%);
  top:-100px;right:-80px;filter:blur(65px);
  animation:heroOrbFloat1 13s ease-in-out infinite alternate;
}
.hero-glow-orb.orb-2{
  width:540px;height:540px;
  background:radial-gradient(circle at 50% 50%, rgba(220,210,180,0.2) 0%, rgba(40,69,238,0.08) 45%, transparent 70%);
  bottom:-120px;left:-90px;filter:blur(60px);
  animation:heroOrbFloat2 15s ease-in-out infinite alternate;
}
.hero-glow-orb.orb-3{
  width:440px;height:440px;
  background:radial-gradient(circle at 45% 45%, rgba(14,165,233,0.12) 0%, rgba(40,69,238,0.08) 50%, transparent 72%);
  top:28%;right:12%;filter:blur(52px);
  animation:heroOrbFloat3 11s ease-in-out infinite alternate;
}
.hero-glow-orb.orb-4{
  width:380px;height:380px;
  background:radial-gradient(circle at 50% 50%, rgba(225,215,190,0.18) 0%, rgba(40,69,238,0.06) 45%, transparent 70%);
  top:-40px;left:18%;filter:blur(48px);
  animation:heroOrbFloat4 16s ease-in-out infinite alternate;
}
.hero-glow-orb.orb-5{
  width:480px;height:480px;
  background:radial-gradient(circle at 40% 40%, rgba(40,69,238,0.12) 0%, rgba(215,205,175,0.14) 48%, transparent 72%);
  bottom:-60px;right:6%;filter:blur(58px);
  animation:heroOrbFloat5 14s ease-in-out infinite alternate;
}

@keyframes heroOrbFloat1{
  0%{transform:translate3d(0,0,0) scale(1)}
  50%{transform:translate3d(-80px,50px,0) scale(1.14)}
  100%{transform:translate3d(-140px,-35px,0) scale(0.94)}
}
@keyframes heroOrbFloat2{
  0%{transform:translate3d(0,0,0) scale(0.96)}
