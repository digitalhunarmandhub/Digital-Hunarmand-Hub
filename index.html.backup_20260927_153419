// Mobile touch - persistent card highlight effect
(function(){
  if(!('ontouchstart' in window)) return;
  
  // Cards that should have persistent tap highlight
  const selectors = ['.svc-card','.tc','.vmc-card','.wc','.cc','.benefit-item','.pos-item','.lead-card','.project-card','.pstat-card'];
  
  selectors.forEach(function(sel){
    document.querySelectorAll(sel).forEach(function(card){
      card.addEventListener('touchstart', function(){
        // Remove tapped from siblings
        document.querySelectorAll(sel).forEach(function(c){ c.classList.remove('tapped'); });
        card.classList.add('tapped');
      }, {passive:true});
    });
  });
  
  // Tap outside removes tapped
  document.addEventListener('touchstart', function(e){
    const allCards = document.querySelectorAll('.svc-card,.tc,.vmc-card,.wc,.cc,.benefit-item,.pos-item,.project-card,.pstat-card');
    let hitCard = false;
    allCards.forEach(function(c){ if(c.contains(e.target)) hitCard = true; });
    if(!hitCard) allCards.forEach(function(c){ c.classList.remove('tapped'); });
  }, {passive:true});
})();
</script>

