/* ── BACK TO TOP BUTTON ── */
.back-to-top{
  position:fixed;
  bottom:96px;
  right:28px;
  width:48px;
  height:48px;
  background:linear-gradient(135deg,#0c1c4f,#131f4a);
  border:1.5px solid rgba(56,189,248,0.45);
  border-radius:50%;
  color:#38bdf8;
  display:flex;
  align-items:center;
  justify-content:center;
  cursor:pointer;
  z-index:995;
  box-shadow:0 8px 24px rgba(15,23,42,0.35),0 0 12px rgba(56,189,248,0.15);
  opacity:0;
  visibility:hidden;
  pointer-events:none;
  transform:translateY(16px) scale(0.9);
  transition:opacity .32s cubic-bezier(0.16,1,0.3,1),transform .32s cubic-bezier(0.16,1,0.3,1),visibility .32s,background .25s,border-color .25s,box-shadow .25s;
}
.back-to-top.show{
  opacity:1;
  visibility:visible;
  pointer-events:auto;
  transform:translateY(0) scale(1);
}
.back-to-top:hover{
  transform:translateY(-3px) scale(1.08);
  color:#ffffff;
  background:linear-gradient(135deg,#2845EE,#1d35c7);
  border-color:#60a5fa;
  box-shadow:0 12px 28px rgba(40,69,238,0.45),0 0 18px rgba(96,165,250,0.35);
}
.back-to-top:active{
  transform:scale(0.92);
}

/* ── AI SIDE PEEKER TAB (Shows on scroll when AI FAB tucks) ── */
.ai-peeker{
  position:fixed;
  bottom:32px;
  right:0;
  z-index:998;
  display:flex;
  align-items:center;
  gap:7px;
  background:linear-gradient(135deg,#0c1c4f 0%,#152968 50%,#1e50d8 100%);
  border:1.5px solid #38bdf8;
  border-right:none;
  border-radius:18px 0 0 18px;
  padding:8px 10px 8px 12px;
  color:#ffffff;
  cursor:pointer;
  box-shadow:-4px 8px 24px rgba(12,28,79,0.5),0 0 14px rgba(56,189,248,0.25);
  transform:translateX(108%);
  transition:transform .35s cubic-bezier(0.16,1,0.3,1),box-shadow .25s ease;
  user-select:none;
  -webkit-user-select:none;
}
.ai-peeker.show{
  transform:translateX(0);
}
.ai-peeker:hover{
  transform:translateX(-4px);
  box-shadow:-6px 10px 28px rgba(59,91,255,0.55),0 0 20px rgba(96,165,250,0.4);
}
.ai-peeker-arrow{
  color:#38bdf8;
  animation:peekerNudge 1.8s ease-in-out infinite;
  flex-shrink:0;
}
@keyframes peekerNudge{
  0%,100%{transform:translateX(0)}
  50%{transform:translateX(-3px)}
}
.ai-peeker-avatar{
  width:24px;
  height:24px;
  border-radius:50%;
  overflow:hidden;
  border:1.5px solid #38bdf8;
  flex-shrink:0;
}
.ai-peeker-avatar img{
  width:100%;
  height:100%;
  object-fit:cover;
}
.ai-peeker-text{
  font-family:var(--mono);
  font-size:11px;
  font-weight:700;
  letter-spacing:1px;
  color:#ffffff;
}

/* ── CFAB TUCKED / SLIDE-INTO-EDGE STATE ── */
.cfab.tucked{
  transform:translateX(120px) scale(0.85)!important;
  opacity:0!important;
  pointer-events:none!important;
}
.cfab.pop-attention{
  animation:popAttention .5s cubic-bezier(0.16,1,0.3,1);
}
@keyframes popAttention{
  0%{transform:scale(0.8)}
  50%{transform:scale(1.15)}
  100%{transform:scale(1)}
}

