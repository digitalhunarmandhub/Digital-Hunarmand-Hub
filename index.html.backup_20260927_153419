  margin:0;
}
.dc-form-grid{
  display:grid;
  grid-template-columns:repeat(2, 1fr);
  gap:16px;
  margin-bottom:20px;
}
.dc-col-full{
  grid-column:1 / -1;
}
.dc-form-group{
  display:flex;
  flex-direction:column;
  gap:6px;
}
.dc-form-label{
  font-size:12px;
  font-weight:700;
  color:#334155;
  display:flex;
  align-items:center;
  gap:4px;
}
.dc-req{
  color:#ef4444;
}
.dc-input-wrap{
  position:relative;
  display:flex;
  align-items:center;
}
.dc-input-icon{
  position:absolute;
  left:13px;
  color:#94a3b8;
  pointer-events:none;
  transition:color .2s;
}
.dc-form-input,
.dc-form-select,
.dc-form-textarea{
  width:100%;
  padding:10px 14px 10px 38px;
  background:var(--bg-cream-soft);
  border:1.5px solid var(--border-card);
  border-radius:14px;
  font-family:inherit;
  font-size:13px;
  color:var(--text-dark);
  outline:none;
  transition:all .2s ease;
  box-shadow:var(--shadow-inset);
}
.dc-form-textarea{
  padding-left:38px;
  resize:vertical;
}
.dc-form-input:focus,
.dc-form-select:focus,
.dc-form-textarea:focus{
  border-color:var(--blue);
  box-shadow:0 0 0 3.5px rgba(40, 69, 238, 0.15);
}
.dc-form-input:focus ~ .dc-input-icon,
.dc-form-select:focus ~ .dc-input-icon,
.dc-form-textarea:focus ~ .dc-input-icon{
  color:var(--blue);
}
@keyframes dcFieldShake{
  0%, 100%{transform:translateX(0)}
  20%, 60%{transform:translateX(-6px)}
  40%, 80%{transform:translateX(6px)}
}
.dc-form-input.is-invalid,
.dc-form-select.is-invalid{
  border-color:#ef4444 !important;
  background:#fff8f8 !important;
  box-shadow:0 0 0 3.5px rgba(239, 68, 68, 0.2) !important;
  animation:dcFieldShake 0.35s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
}
.dc-form-input.is-invalid ~ .dc-input-icon{
  color:#ef4444 !important;
}
.dc-error-msg{
  font-size:11.5px;
  color:#ef4444;
  font-weight:700;
  display:none;
  margin-top:2px;
}
.dc-error-msg.visible{
  display:block;
}
.dc-form-submit-wrap{
  display:flex;
  flex-direction:column;
  gap:10px;
  align-items:center;
}
.btn-dc-submit-enroll{
  width:100%;
  padding:13px 24px;
  background:linear-gradient(135deg, #2845EE 0%, #1d35c7 50%, #7c3aed 100%);
  color:#ffffff !important;
  border:none;
  border-radius:50px;
  font-family:inherit;
  font-size:14px;
  font-weight:800;
  letter-spacing:.3px;
  cursor:pointer;
  transition:all .25s ease;
  box-shadow:0 8px 24px rgba(40, 69, 238, 0.35), inset 0 1px 0 rgba(255,255,255,0.35);
  display:flex;
  align-items:center;
  justify-content:center;
  gap:8px;
}
.btn-dc-submit-enroll:hover{
  transform:translateY(-2px);
  box-shadow:0 12px 30px rgba(40, 69, 238, 0.45);
}
.dc-form-guarantee{
  display:flex;
  align-items:center;
  gap:6px;
  font-size:11.5px;
  font-weight:600;
  color:#64748b;
}

/* Success State */
.dc-enroll-success{
  text-align:center;
  padding:12px 6px;
}
.dc-success-badge-icon{
  width:72px;
  height:72px;
  border-radius:50%;
  background:rgba(34, 197, 94, 0.12);
  border:2px solid rgba(34, 197, 94, 0.3);
  display:flex;
  align-items:center;
  justify-content:center;
  margin:0 auto 16px;
  box-shadow:0 10px 25px rgba(34, 197, 94, 0.2);
}
.dc-success-title{
  font-size:22px;
  font-weight:800;
  color:var(--text-dark);
  margin-bottom:6px;
}
.dc-success-subtitle{
  font-size:13.5px;
  color:#64748b;
  margin-bottom:20px;
  line-height:1.5;
}
.dc-receipt-box{
  background:var(--bg-cream-soft);
  border:1.5px dashed var(--border-card);
  border-radius:16px;
  padding:16px 20px;
  text-align:left;
  margin-bottom:22px;
}
.dc-receipt-row{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:8px 0;
  border-bottom:1px solid var(--border-card);
  font-size:13px;
}
.dc-receipt-row:last-child{
  border-bottom:none;
}
.dc-receipt-label{
  color:#64748b;
  font-weight:600;
}
.dc-receipt-id{
  font-family:var(--mono);
  background:rgba(40, 69, 238, 0.08);
  color:var(--blue);
  padding:2px 8px;
  border-radius:6px;
  font-size:12px;
}
.dc-success-actions{
  display:flex;
  flex-direction:column;
  gap:10px;
}
.btn-dc-success-wa{
  width:100%;
  padding:13px 20px;
  background:#22c55e;
  color:#ffffff !important;
  border-radius:50px;
  font-size:14px;
  font-weight:800;
  text-decoration:none;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:8px;
  transition:all .25s ease;
  box-shadow:0 8px 24px rgba(34, 197, 94, 0.35);
}
.btn-dc-success-wa:hover{
  background:#16a34a;
  transform:translateY(-2px);
  box-shadow:0 12px 30px rgba(34, 197, 94, 0.45);
}
.btn-dc-close-succ{
  background:transparent;
  border:1px solid var(--border-card);
  color:#64748b;
  padding:10px 18px;
  border-radius:50px;
  font-size:13px;
  font-weight:700;
  cursor:pointer;
  transition:all .2s;
  outline:none;
}
.btn-dc-close-succ:hover{
  background:var(--bg-cream-soft);
  color:var(--text-dark);
}

/* ── GAMIFIED CONTROLS IN ENROLLMENT MODAL ── */
.dc-gamified-grid{
  display:grid;
  grid-template-columns:repeat(2, 1fr);
  gap:10px;
}
.dc-gamified-grid.dc-grid-3{
  grid-template-columns:repeat(3, 1fr);
  gap:8px;
}
.dc-game-chip{
  background:var(--bg-cream-card);
  border:1px solid var(--border-card);
  border-radius:16px;
  padding:10px 12px;
  display:flex;
  align-items:center;
  gap:8px;
  cursor:pointer;
  transition:all .22s cubic-bezier(0.16, 1, 0.3, 1);
  user-select:none;
  position:relative;
  overflow:hidden;
  box-shadow:var(--shadow-soft);
}
.dc-grid-3 .dc-game-chip{
  padding:8px 8px;
  gap:6px;
}
.dc-game-chip:hover{
  border-color:rgba(59, 91, 255, 0.45);
  background:linear-gradient(135deg, rgba(238, 245, 255, 0.95) 0%, rgba(245, 243, 255, 0.85) 100%);
  transform:translateY(-1.5px);
}
.dc-game-chip.is-active{
  border-color:var(--blue);
  background:linear-gradient(135deg, rgba(59, 91, 255, 0.09) 0%, rgba(139, 62, 242, 0.09) 100%);
  box-shadow:0 0 0 2px rgba(59, 91, 255, 0.22), 0 6px 18px rgba(59, 91, 255, 0.12);
}
.dc-game-ico{
  width:32px;
  height:32px;
  border-radius:10px;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  flex-shrink:0;
  background:rgba(59, 91, 255, 0.08);
  transition:all .22s ease;
}
.dc-grid-3 .dc-game-ico{
  width:26px;
  height:26px;
  border-radius:8px;
}
.dc-grid-3 .dc-game-ico svg{
  width:16px;
  height:16px;
}
.dc-game-chip:hover .dc-game-ico{
  transform:scale(1.08);
  background:rgba(59, 91, 255, 0.14);
}
.dc-game-chip.is-active .dc-game-ico{
  background:linear-gradient(135deg, rgba(59, 91, 255, 0.18) 0%, rgba(139, 62, 242, 0.18) 100%);
  transform:scale(1.08);
}
.dc-game-ico svg{
  width:20px;
  height:20px;
  display:block;
}
.dc-game-info{
  display:flex;
  flex-direction:column;
  text-align:left;
  line-height:1.2;
  min-width:0;
}
.dc-game-title{
  font-size:12px;
  font-weight:800;
  color:var(--text-dark);
  margin-bottom:2px;
}
.dc-grid-3 .dc-game-title{
  font-size:11px;
  letter-spacing:-0.2px;
  white-space:nowrap;
}
.dc-game-chip.is-active .dc-game-title{
  color:var(--blue);
}
.dc-game-sub{
  font-size:10px;
  color:#64748b;
  font-weight:600;
}
.dc-grid-3 .dc-game-sub{
  font-size:8.5px;
  white-space:nowrap;
}
.dc-game-badge{
  font-family:var(--mono);
  font-size:8.5px;
  font-weight:800;
  padding:2.5px 7.5px;
  border-radius:5px;
  background:linear-gradient(135deg, #2845EE, #1d35c7);
  color:#ffffff;
  letter-spacing:.5px;
  margin-left:auto;
  flex-shrink:0;
  box-shadow:0 2px 6px rgba(40, 69, 238, 0.28);
  transition:all .22s ease;
}
.dc-grid-3 .dc-game-badge{
  font-size:7.5px;
  padding:2px 5.5px;
  border-radius:4px;
  letter-spacing:0.2px;
}
.dc-game-chip:hover .dc-game-badge{
  box-shadow:0 3px 10px rgba(59, 91, 255, 0.4);
  transform:scale(1.04);
}
.dc-game-chip.is-active .dc-game-badge{
  background:linear-gradient(135deg, #2563eb, #8B3EF2);
  color:#ffffff;
  box-shadow:0 3px 12px rgba(59, 91, 255, 0.45);
}

@media(max-width:640px){
  .dc-modal-card{
    padding:26px 18px;
  }
  .dc-form-grid{
    grid-template-columns:1fr;
    gap:14px;
  }
  .dc-gamified-grid,
  .dc-gamified-grid.dc-grid-3{
    grid-template-columns:1fr;
    gap:8px;
  }
}

@media(max-width:1200px){
  .dc-grid{
    grid-template-columns:repeat(3,1fr);
    gap:18px;
  }
}
@media(max-width:960px){
  .dc-grid{
    grid-template-columns:repeat(2,1fr);
    gap:16px;
  }
}

@media(max-width:768px){
  .dc-filters-wrap{
    display:flex !important;
    justify-content:flex-start !important;
    overflow-x:auto !important;
    -webkit-overflow-scrolling:touch !important;
    scrollbar-width:none !important;
    -ms-overflow-style:none !important;
    padding:4px 2px 14px !important;
    margin-bottom:20px !important;
    width:100% !important;
  }
  .dc-filters-wrap::-webkit-scrollbar{
    display:none !important;
  }
  .dc-filters{
    max-width:none !important;
    width:max-content !important;
    flex-shrink:0 !important;
    flex-wrap:nowrap !important;
    margin:0 !important;
  }
  .dc-filter-btn{
    padding:7px 15px !important;
    font-size:12px !important;
    white-space:nowrap !important;
    flex-shrink:0 !important;
  }
  /* Specific Categories: Horizontal swipe carousel in mobile mode */
  .dc-grid.dc-grid-scrollable{
    display:flex !important;
    overflow-x:auto !important;
    scroll-snap-type:x mandatory !important;
    -webkit-overflow-scrolling:touch !important;
    gap:16px !important;
    padding-bottom:16px !important;
    margin:0 -18px 36px !important;
    padding-left:18px !important;
    padding-right:18px !important;
    scrollbar-width:thin !important;
  }
  .dc-grid.dc-grid-scrollable::-webkit-scrollbar{
    height:4px !important;
  }
  .dc-grid.dc-grid-scrollable::-webkit-scrollbar-thumb{
    background:#cbd5e1 !important;
    border-radius:4px !important;
  }
  .dc-grid.dc-grid-scrollable .dc-card{
    flex:0 0 285px !important;
    width:285px !important;
    max-width:285px !important;
    scroll-snap-align:start !important;
  }

  /* "All Courses" Category: YouTube-style vertical feed (scroll down naturally) */
  .dc-grid.dc-grid-vertical,
  .dc-grid:not(.dc-grid-scrollable){
    display:flex !important;
    flex-direction:column !important;
    gap:20px !important;
    margin:0 0 40px !important;
    padding:0 !important;
    overflow:visible !important;
    width:100% !important;
  }
  .dc-grid.dc-grid-vertical .dc-card,
  .dc-grid:not(.dc-grid-scrollable) .dc-card{
    width:100% !important;
    max-width:100% !important;
    flex:none !important;
    border-radius:20px !important;
    box-shadow:0 8px 24px rgba(15,23,42,0.06) !important;
  }
  .dc-grid.dc-grid-vertical .dc-card-thumb,
  .dc-grid:not(.dc-grid-scrollable) .dc-card-thumb{
    height:auto !important;
    aspect-ratio:16/9 !important;
    width:100% !important;
  }
  .dc-grid.dc-grid-vertical .dc-card-body,
  .dc-grid:not(.dc-grid-scrollable) .dc-card-body{
    padding:18px 16px !important;
  }
  .dc-grid.dc-grid-vertical .dc-card-title,
  .dc-grid:not(.dc-grid-scrollable) .dc-card-title{
    font-size:17px !important;
    line-height:1.3 !important;
    margin-bottom:6px !important;
  }
  .dc-grid.dc-grid-vertical .dc-card-desc,
  .dc-grid:not(.dc-grid-scrollable) .dc-card-desc{
    font-size:12.5px !important;
    line-height:1.55 !important;
    margin-bottom:12px !important;
  }
  .dc-search-wrap{
    margin-bottom:18px !important;
  }
}
@media(max-width:640px){
  .dc-grid{
    grid-template-columns:1fr;
    gap:18px;
  }
}

@media(max-width:1024px){
  .courses-grid-row{
    grid-template-columns:repeat(2,1fr);
    gap:16px;
  }
}
@media(max-width:768px){
  .courses-grid-row{
    display:flex;
    overflow-x:auto;
    scroll-snap-type:x mandatory;
    -webkit-overflow-scrolling:touch;
    gap:14px;
    padding-bottom:12px;
    margin:0 -16px;
    padding-left:16px;
    padding-right:16px;
  }
  .courses-grid-row::-webkit-scrollbar{
    height:4px;
  }
  .courses-grid-row::-webkit-scrollbar-thumb{
    background:#cbd5e1;
    border-radius:4px;
  }
  .coursera-card{
    flex:0 0 250px;
    scroll-snap-align:start;
  }
  .coursera-thumb{
    height:135px;
  }
}

/* CONTACT */
.contact{background:linear-gradient(180deg,#edf2fc 0%,var(--bg-cream) 100%)}
.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px;align-items:start}
.cbox{background:var(--bg-cream-card);border-radius:26px;padding:40px;box-shadow:var(--shadow-soft);border:1px solid var(--border-card)}
.cbox h3{font-size:20px;font-weight:800;margin-bottom:28px;color:var(--text-dark);letter-spacing:-.5px}
.ci{display:flex;align-items:flex-start;gap:14px;padding:16px 0;border-bottom:1px solid var(--border-card)}
.ci:last-of-type{border-bottom:none;padding-bottom:0}
.ci-ico{width:42px;height:42px;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;overflow:hidden}
.ci-ico img{width:100%;height:100%;object-fit:cover;border-radius:12px}
.ci-ph{background:none}
.ci-em{background:none}
.ci-lbl{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:2px;color:var(--muted);margin-bottom:3px}
.ci-val{font-size:15px;font-weight:600;color:var(--text-dark);transition:color .2s}
.ci-val:hover{color:var(--blue)}
.ctag{margin-top:24px;font-size:20px;font-weight:800;line-height:1.4;letter-spacing:-.5px}
.sg{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:20px}
.sl-btn{display:flex;align-items:center;gap:12px;border:1px solid var(--border-card);padding:13px 14px;border-radius:16px;font-size:13px;font-weight:600;color:var(--text-dark);background:var(--bg-cream-soft);transition:all .25s ease;position:relative;overflow:hidden;box-shadow:var(--shadow-soft)}
.sl-btn:hover{border-color:transparent;color:#fff;transform:translateY(-2px);box-shadow:0 8px 20px rgba(0,0,0,.12)}
.sl-btn.fb:hover{background:#1877f2}.sl-btn.tt:hover{background:#000000}.sl-btn.ig:hover{background:linear-gradient(135deg,#f09433,#dc2743,#bc1888)}.sl-btn.wa:hover{background:#25d366}.sl-btn.wg:hover{background:#128c7e}.sl-btn.gm:hover{background:#ea4335}
